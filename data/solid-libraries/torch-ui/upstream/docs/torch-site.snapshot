<Timeline
  items={[
    { title: 'Quest accepted', description: 'Took the goblin raid contract from the Thornwall notice board.', time: 'Dawn', status: 'completed' },
    { title: 'Entered the Greywood', description: 'Tracked the goblin raiding party northward.', time: 'Morning', status: 'completed' },
    { title: 'Combat — goblin camp', description: 'Engaging three goblins and a worg.', time: 'Midday', status: 'active' },
    { title: 'Recover the stolen grain', description: "Search the camp for the farmer's stores.", status: 'pending' },
    { title: 'Return to Thornwall', status: 'pending' },
  ]}
/>`,roe=`import { Timeline } from '@torch-ui/solid/data-display'
import { Tag } from '@torch-ui/solid/data-display'
import { Sword, Star, Map, Scroll } from 'lucide-solid'

<Timeline
  items={[
    {
      title: "Session 12 — The Dragon's Den",
      description: 'Party defeated Skarveth the Red and claimed the hoard.',
      time: 'Sat Mar 8',
      status: 'completed',
      icon: <Sword class="h-4 w-4" />,
      content: (
        <div class="mt-1 flex flex-wrap gap-1">
          {['8,400 XP', '1,200 gp', 'Flame Tongue', 'Ring of Protection'].map(loot => (
            <Tag variant="warning" size="sm">{loot}</Tag>
          ))}
        </div>
      ),
    },
    { title: 'Party reached level 7', time: 'Sat Mar 8', status: 'completed', icon: <Star class="h-4 w-4" /> },
    { title: 'Session 11 — The Bridge of Shadows', time: 'Sat Mar 1', status: 'completed', icon: <Map class="h-4 w-4" /> },
    { title: 'Session 10 — Thornwall Intrigue', time: 'Sat Feb 22', status: 'completed', icon: <Scroll class="h-4 w-4" /> },
  ]}
/>`,noe=`import { Timeline } from '@torch-ui/solid/data-display'
import { UserPlus } from 'lucide-solid'

<Timeline
  timeLeft
  items={[
    { title: 'Aldric the Paladin joined', description: 'Recruited in Thornwall after the goblin contract.', time: '2 sessions ago', status: 'completed', icon: <UserPlus class="h-4 w-4" />, color: 'bg-primary-500' },
    { title: 'Arrived at Millhaven', description: 'Reached the city after 3 days overland travel.', time: '3 sessions ago', status: 'completed', color: 'bg-info-500' },
    { title: 'Total party kill', description: 'Ambushed by undead — all characters slain.', time: '4 sessions ago', status: 'error' },
    { title: 'Campaign started', description: 'The party met at the Prancing Pony in Thornwall.', time: 'Session 1', status: 'completed', color: 'bg-success-500' },
  ]}
/>`,aoe=`import { Timeline } from '@torch-ui/solid/data-display'

<Timeline
  connector="dashed"
  items={[
    {
      title: 'Clearing the dungeon',
      description: '9 of 14 rooms explored.',
      time: 'Session 9–10',
      status: 'active',
      content: (
        <div class="rounded-lg border border-surface-border bg-surface-dim p-3">
          <div class="mb-1.5 flex justify-between text-xs text-ink-600">
            <span>Rooms cleared</span>
            <span class="font-medium text-ink-900">9 / 14</span>
          </div>
          <div class="h-1.5 w-full rounded-full bg-surface-border">
            <div class="h-1.5 rounded-full bg-primary-500" style={{ width: '64%' }} />
          </div>
        </div>
      ),
