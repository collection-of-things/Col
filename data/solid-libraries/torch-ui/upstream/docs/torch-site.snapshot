import { FileUpload, type FileUploadItem } from '@torch-ui/solid/forms'

const [files, setFiles] = createSignal<FileUploadItem[]>([])

const onAddFiles = (newFiles: File[]) => {
  const items: FileUploadItem[] = newFiles.map((file) => ({
    id: crypto.randomUUID(),
    file,
    status: 'done',
  }))
  setFiles((prev) => [...prev, ...items])
}

<FileUpload
  label="Upload Files"
  description="Max 10 MB. Omit accept to allow any file type."
  files={files()}
  onAddFiles={onAddFiles}
  onRemove={(id) => setFiles((prev) => prev.filter((f) => f.id !== id))}
  maxFileSize={10 * 1024 * 1024}
  variant="dropzone"
/>`,Aq=`import { FileUpload, type FileUploadItem } from '@torch-ui/solid/forms'

const [files, setFiles] = createSignal<FileUploadItem[]>([])

<FileUpload
  label="Attachments"
  files={files()}
  onAddFiles={(newFiles) => {
    setFiles((prev) => [
      ...prev,
      ...newFiles.map((file) => ({
        id: crypto.randomUUID(),
        file,
        status: 'done',
      })),
    ])
  }}
  onRemove={(id) => setFiles((prev) => prev.filter((f) => f.id !== id))}
  variant="button"
  maxFiles={3}
/>`,Eq=`import { createSignal } from 'solid-js'
import { FileUpload, type FileUploadItem } from '@torch-ui/solid/forms'

const [files, setFiles] = createSignal<FileUploadItem[]>([])

// Parent runs upload (e.g. fetch with progress) and updates status/progress.
// This example simulates progress then sets status to 'done'.
const onAddFiles = (newFiles: File[]) => {
  newFiles.forEach((file) => {
    const id = crypto.randomUUID()
    setFiles((prev) => [...prev, { id, file, status: 'uploading', progress: 0 }])
    let p = 0
    const iv = setInterval(() => {
      p += 20
      setFiles((prev) =>
        prev.map((f) => (f.id === id ? { ...f, progress: p } : f))
      )
      if (p >= 100) {
        clearInterval(iv)
        setFiles((prev) =>
          prev.map((f) => (f.id === id ? { ...f, status: 'done' as const, progress: 100 } : f))
        )
      }
    }, 200)
  })
}

<FileUpload
  files={files()}
  onAddFiles={onAddFiles}
  onRemove={(id) => setFiles((prev) => prev.filter((f) => f.id !== id))}
  variant="dropzone"
/>`,Pq=`import { FileUpload, type FileUploadItem } from '@torch-ui/solid/forms'

<FileUpload
