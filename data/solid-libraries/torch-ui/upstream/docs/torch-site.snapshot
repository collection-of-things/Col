  <Popover.Trigger as="button" class="rounded-lg border-2 border-primary-500 px-3 py-2 text-sm font-medium text-primary-600 hover:bg-primary-500/10 outline-none focus-visible:ring-4 focus-visible:ring-primary-500/50">
    {open() ? 'Close' : 'Open'}
  </Popover.Trigger>
  <Popover.Content>
