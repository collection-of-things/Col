import { Slider } from '@torch-ui/solid/forms'

const [mana, setMana] = createSignal([50])
const [manaEnd, setManaEnd] = createSignal([25])
const [committed, setCommitted] = createSignal([25])

// Updates continuously while dragging
<Slider label="Mana Flow" value={mana()} onValueChange={setMana} />
<p>Current mana: {mana()[0]}</p>

// Display updates only when user releases (use onValueChangeEnd for "committed" value)
<Slider
  label="Mana Reserve"
  value={manaEnd()}
  onValueChange={setManaEnd}
  onValueChangeEnd={(v) => { setManaEnd(v); setCommitted(v); }}
/>
