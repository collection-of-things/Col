import type { SelectOption } from '@torch-ui/solid/forms'
import { Globe, MapPin } from 'lucide-solid'

// Status dot only: use color (hex, rgb(), or CSS color name)
const statusOptions: SelectOption[] = [
  { value: 'active', label: 'Active', color: '#22c55e' },
  { value: 'paused', label: 'Paused', color: '#eab308' },
  { value: 'draft', label: 'Draft', color: '#94a3b8' },
]

// Icon or flag: use icon (Lucide, emoji, or any JSX)
const regionOptions: SelectOption[] = [
  { value: 'us', label: 'United States', icon: <Globe class="h-4 w-4" /> },
  { value: 'uk', label: 'United Kingdom', icon: <span>🇬🇧</span> },
  { value: 'ca', label: 'Canada', icon: <span>🇨🇦</span> },
]

// Both: color (dot) + icon — dot renders first, then icon, then label
const locationOptions: SelectOption[] = [
  { value: 'live', label: 'Live', color: '#22c55e', icon: <MapPin class="h-4 w-4" /> },
  { value: 'paused', label: 'Paused', color: '#eab308', icon: <MapPin class="h-4 w-4" /> },
  { value: 'draft', label: 'Draft', color: '#94a3b8', icon: <MapPin class="h-4 w-4" /> },
]

