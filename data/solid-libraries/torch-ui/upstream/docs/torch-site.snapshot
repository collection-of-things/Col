import { Card, Form, WizardStepper } from '@torch-ui/solid/layout'
import { Input, Select, Checkbox } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'

const STEP_LABELS = ['Account', 'Organization', 'Review']

const ROLE_OPTIONS = [
  { value: 'developer', label: 'Developer' },
  { value: 'designer', label: 'Designer' },
  { value: 'manager', label: 'Manager' },
  { value: 'executive', label: 'Executive' },
  { value: 'other', label: 'Other' },
]

const TEAM_SIZE_OPTIONS = [
  { value: '1', label: 'Just me' },
  { value: '2-10', label: '2–10 people' },
  { value: '11-50', label: '11–50 people' },
  { value: '51-200', label: '51–200 people' },
  { value: '200+', label: '200+ people' },
]

export function WizardFlow() {
  const [step, setStep] = createSignal(1)
  const [submitting, setSubmitting] = createSignal(false)
  const [done, setDone] = createSignal(false)

  const [name, setName] = createSignal('')
  const [email, setEmail] = createSignal('')
  const [role, setRole] = createSignal('developer')
  const [orgName, setOrgName] = createSignal('')
  const [teamSize, setTeamSize] = createSignal('2-10')
  const [acceptUpdates, setAcceptUpdates] = createSignal(true)

  async function handleFinish(e: SubmitEvent) {
    e.preventDefault()
    setSubmitting(true)
    await new Promise((r) => setTimeout(r, 1200))
    setSubmitting(false)
    setDone(true)
  }

  if (done()) {
    return (
      <Card class="w-full max-w-lg mx-auto text-center">
        <Card.Body class="py-12">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/30">
            <svg class="h-7 w-7 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-ink-900">You're all set!</h2>
          <p class="mt-2 text-sm text-ink-600">Welcome, {name()}. Your workspace <strong>{orgName()}</strong> is ready.</p>
        </Card.Body>
      </Card>
    )
  }

  return (
    <Card class="w-full max-w-lg mx-auto">
      <Card.Body>
        <WizardStepper step={step()} totalSteps={STEP_LABELS.length} stepLabels={STEP_LABELS} variant="pills" class="mb-6" />

        <Show when={step() === 1}>
          <Form onSubmit={(e) => { e.preventDefault(); setStep(2) }} class="gap-4">
            <div>
              <h2 class="text-lg font-semibold text-ink-900">Your account</h2>
              <p class="mt-1 text-sm text-ink-600">Tell us a little about yourself.</p>
            </div>
            <Input label="Full name" placeholder="Caelan Torchward" value={name()} onValueChange={setName} required />
            <Input label="Work email" type="email" placeholder="you@company.com" value={email()} onValueChange={setEmail} required />
            <Select label="Your role" options={ROLE_OPTIONS} value={role()} onValueChange={setRole} />
            <div class="flex justify-end">
              <Button type="submit" variant="primary">Next</Button>
            </div>
          </Form>
        </Show>

        <Show when={step() === 2}>
          <Form onSubmit={(e) => { e.preventDefault(); setStep(3) }} class="gap-4">
            <div>
              <h2 class="text-lg font-semibold text-ink-900">Your organization</h2>
              <p class="mt-1 text-sm text-ink-600">Set up your team workspace.</p>
            </div>
            <Input label="Organization name" placeholder="Acme Corp" value={orgName()} onValueChange={setOrgName} required />
            <Select label="Team size" options={TEAM_SIZE_OPTIONS} value={teamSize()} onValueChange={setTeamSize} />
            <Checkbox label="Send me product updates and tips" checked={acceptUpdates()} onValueChange={setAcceptUpdates} />
            <div class="flex justify-between">
              <Button variant="ghost" onClick={() => setStep(1)}>Back</Button>
              <Button type="submit" variant="primary">Next</Button>
            </div>
          </Form>
        </Show>

        <Show when={step() === 3}>
          <Form onSubmit={handleFinish} class="gap-4">
            <div>
              <h2 class="text-lg font-semibold text-ink-900">Review &amp; confirm</h2>
              <p class="mt-1 text-sm text-ink-600">Everything look right?</p>
            </div>
            <Card variant="flat" class="divide-y divide-surface-border">
              <div class="flex justify-between px-4 py-2.5 text-sm">
                <span class="text-ink-500">Name</span>
                <span class="font-medium text-ink-900">{name()}</span>
              </div>
              <div class="flex justify-between px-4 py-2.5 text-sm">
                <span class="text-ink-500">Email</span>
                <span class="font-medium text-ink-900">{email()}</span>
              </div>
              <div class="flex justify-between px-4 py-2.5 text-sm">
                <span class="text-ink-500">Organization</span>
                <span class="font-medium text-ink-900">{orgName()}</span>
              </div>
            </Card>
            <div class="flex justify-between">
              <Button variant="ghost" onClick={() => setStep(2)}>Back</Button>
              <Button type="submit" variant="primary" loading={submitting()}>Finish setup</Button>
            </div>
          </Form>
        </Show>
      </Card.Body>
    </Card>
  )
}`;function xse(){return r(fe,{title:"Wizard Flow",description:"A 3-step onboarding wizard using WizardStepper with the pills variant. Each step is a separate form that validates before advancing. The final step shows a review summary.",get children(){return r(I,{id:"preview",title:"Preview",description:"Fill in each step and click Next to advance. The pills stepper at the top shows progress. Step 3 shows a read-only review before finishing.",code:yse,exampleWidth:"lg",get children(){return r(vse,{})}})}})}var wse=p('<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">');const Cse=[4200,3800,5100,4700,6200,5800,7400,6900,8100,7600,9200,8800],kse=[120,145,132,160,178,165,190,210,198,225,242,238],Sse=[85,92,78,95,110,98,115,125,108,132,128,140],$se=[3.2,3.8,4.1,3.6,3.1,2.9,3.4,3.7,4.2,3.8,3.5,3.1];function _se(){return(()=>{var t=wse();return i(t,r(at,{label:"Monthly Revenue",value:"$87,492",trendLabel:"+14.2% from last month",trendVariant:"positive",get trendIcon(){return r(Nr,{class:"h-3.5 w-3.5"})},get icon(){return r(OS,{class:"h-5 w-5 text-emerald-500"})},get chart(){return r(Gt,{data:Cse,color:"#10b981",class:"h-10","aria-hidden":"true"})},chartA11yLabel:"Revenue trend over last 12 months"}),null),i(t,r(at,{label:"Active Users",value:"2,381",trendLabel:"+8.7% from last month",trendVariant:"positive",get trendIcon(){return r(Nr,{class:"h-3.5 w-3.5"})},get icon(){return r(dr,{class:"h-5 w-5 text-blue-500"})},get chart(){return r(Gt,{data:kse,color:"#3b82f6",class:"h-10","aria-hidden":"true"})},chartA11yLabel:"Active users trend over last 12 months"}),null),i(t,r(at,{label:"Orders",value:"1,402",trendLabel:"+11.3% from last month",trendVariant:"positive",get trendIcon(){return r(Nr,{class:"h-3.5 w-3.5"})},get icon(){return r(Ha,{class:"h-5 w-5 text-violet-500"})},get chart(){return r(Gt,{data:Sse,color:"#7c3aed",class:"h-10","aria-hidden":"true"})},chartA11yLabel:"Order count trend over last 12 months"}),null),i(t,r(at,{label:"Churn Rate",value:"3.1%",trendLabel:"-0.4% from last month",trendVariant:"negative",get trendIcon(){return r(Bi,{class:"h-3.5 w-3.5"})},get icon(){return r(kC,{class:"h-5 w-5 text-amber-500"})},get chart(){return r(Gt,{data:$se,color:"#f1cf09",class:"h-10","aria-hidden":"true"})},chartA11yLabel:"Churn rate trend over last 12 months"}),null),t})()}const Tse=`import { TrendingUp, TrendingDown, Users, ShoppingCart, DollarSign, Activity } from 'lucide-solid'
import { StatCard } from '@torch-ui/solid/data-display'
import { Sparkline } from '@torch-ui/solid/data-display'

const revenueData = [4200, 3800, 5100, 4700, 6200, 5800, 7400, 6900, 8100, 7600, 9200, 8800]
const usersData   = [120, 145, 132, 160, 178, 165, 190, 210, 198, 225, 242, 238]
const ordersData  = [85, 92, 78, 95, 110, 98, 115, 125, 108, 132, 128, 140]
const churnData   = [3.2, 3.8, 4.1, 3.6, 3.1, 2.9, 3.4, 3.7, 4.2, 3.8, 3.5, 3.1]

export function StatGrid() {
  return (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <StatCard
        label="Monthly Revenue"
        value="$87,492"
        trendLabel="+14.2% from last month"
        trendVariant="positive"
        trendIcon={<TrendingUp class="h-3.5 w-3.5" />}
        icon={<DollarSign class="h-5 w-5 text-emerald-600" />}
        chart={<Sparkline data={revenueData} color="#10b981" class="h-10" />}
        chartA11yLabel="Revenue trend over last 12 months"
      />
      <StatCard
        label="Active Users"
        value="2,381"
        trendLabel="+8.7% from last month"
        trendVariant="positive"
        trendIcon={<TrendingUp class="h-3.5 w-3.5" />}
        icon={<Users class="h-5 w-5 text-blue-600" />}
        chart={<Sparkline data={usersData} color="#3b82f6" class="h-10" />}
        chartA11yLabel="Active users trend over last 12 months"
      />
      <StatCard
        label="Orders"
        value="1,402"
        trendLabel="+11.3% from last month"
        trendVariant="positive"
        trendIcon={<TrendingUp class="h-3.5 w-3.5" />}
        icon={<ShoppingCart class="h-5 w-5 text-violet-600" />}
        chart={<Sparkline data={ordersData} color="#7c3aed" class="h-10" />}
        chartA11yLabel="Order count trend over last 12 months"
      />
      <StatCard
        label="Churn Rate"
        value="3.1%"
        trendLabel="-0.4% from last month"
        trendVariant="positive"
        trendIcon={<TrendingDown class="h-3.5 w-3.5" />}
        icon={<Activity class="h-5 w-5 text-amber-600" />}
        chart={<Sparkline data={churnData} color="#d97706" class="h-10" />}
        chartA11yLabel="Churn rate trend over last 12 months"
      />
    </div>
  )
}`;function Dse(){return r(fe,{title:"Stat Grid",description:"A responsive 4-column grid of StatCards with trend indicators and Sparkline charts. Scales from 1 column on mobile to 4 on wide screens.",get children(){return r(I,{id:"preview",title:"Preview",description:"Each card shows a label, current value, trend vs last month, and a 12-month sparkline. Swap in your real data and color tokens as needed.",code:Tse,exampleWidth:"full",get children(){return r(_se,{})}})}})}var Ise=p('<div class="flex items-start justify-between">'),Ase=p('<div class=mt-4><h2 class="text-base font-semibold text-ink-900">Lyra Swiftfoot</h2><p class="text-sm text-ink-500">Senior Rogue · Guild of Shadows'),Ese=p('<p class="mt-3 text-sm text-ink-600">Specialist in infiltration and intelligence gathering. Seven years on the front lines, three successful heists on the Crimson Keep.'),Pse=p('<div class="mt-3 flex flex-wrap gap-1.5">'),Mse=p('<div class="mt-4 flex flex-col gap-1.5 text-sm text-ink-500"><span class="flex items-center gap-2">Shadowfen, Northern Reach</span><span class="flex items-center gap-2">lyra@guild-of-shadows.org</span><span class="flex items-center gap-2">guild-of-shadows.org/~lyra'),Ose=p('<div class="mt-4 grid grid-cols-3 divide-x divide-surface-border rounded-lg border border-surface-border text-center"><div class=py-3><p class="text-sm font-semibold text-ink-900">142</p><p class="text-xs text-ink-500">Missions</p></div><div class=py-3><p class="text-sm font-semibold text-ink-900">98%</p><p class="text-xs text-ink-500">Success</p></div><div class=py-3><p class="text-sm font-semibold text-ink-900">2.4k</p><p class="text-xs text-ink-500">Followers');function Lse(){const[t,e]=D(!1);return r(De,{class:"w-full max-w-sm mx-auto",get children(){return r(De.Body,{get children(){return[(()=>{var n=Ise();return i(n,r(Ve,{name:"Lyra Swiftfoot",imageUrl:"/images/headshots/lyra_swiftfoot.jpg",size:"lg",shape:"circle"}),null),i(n,r(H,{get variant(){return t()?"outlined":"primary"},si