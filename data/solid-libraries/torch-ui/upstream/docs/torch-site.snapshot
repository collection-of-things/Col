  --code-token-number: #fbbf24;
  --code-token-property: #f87171;
  --code-token-operator: #22d3ee;
  --code-token-variable: #e879f9;
}`;function OX(){return r(fe,{importSnippet:"import { CodeBlock } from '@torch-ui/solid/layout'",title:"Code Block",description:"Multi-line code block with minimal copy icon, syntax highlighting, language switcher, and line numbers.",get children(){return[r(I,{id:"basic-usage",title:"Basic Usage",description:"Single content with language for syntax highlighting. Copy button in the top-right.",code:SX,get children(){var t=$i();return i(t,r(ct,{content:pl,language:"javascript",highlighter:pt})),t}}),r(I,{id:"light",title:"Follow Theme",description:"Omit dark so the block follows the app light/dark theme (e.g. .dark on root).",code:$X,get children(){var t=$i();return i(t,r(ct,{content:pl,language:"javascript",highlighter:pt})),t}}),r(I,{id:"forced-dark",title:"Forced Dark",description:"Set dark to force a dark block regardless of app theme (e.g. dark code on a light page).",code:_X,get children(){var t=$i();return i(t,r(ct,{content:pl,language:"javascript",dark:!0,highlighter:pt})),t}}),r(I,{id:"filename",title:"With Filename",description:"Optional filename or title in the header.",code:TX,get children(){var t=$i();return i(t,r(ct,{filename:"Table.jsx",content:pl,language:"javascript",highlighter:pt})),t}}),r(I,{id:"header-icon",title:"Header Icon",description:"Pass headerIcon to show an icon or image to the left of the filename/label (e.g. framework or language logo).",code:DX,get children(){var t=$i();return i(t,r(ct,{label:"Install",content:"npm install @torch-ui/solid",language:"bash",get headerIcon(){return r(_t,{name:"SolidJS",size:14})},highlighter:pt})),t}}),r(I,{id:"languages",title:"Language Switcher",description:"Multiple language variants with tabs (e.g. JavaScript / TypeScript). Add an optional icon to each language to show it next to the switcher when that variant is selected.",code:IX,get children(){var t=bX(),e=t.firstChild;return e.firstChild,i(t,r(ct,{filename:"example",languages:pp,highlighter:pt}),e),i(e,r(ct,{filename:"example",languages:CX,highlig