import { Card, Form, Section } from '@torch-ui/solid/layout'
import { Input, Switch, Select } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'
import { Tabs } from '@torch-ui/solid/navigation'
import { Alert } from '@torch-ui/solid/feedback'

const TABS = [
  { id: 'profile', label: 'Profile' },
  { id: 'security', label: 'Security' },
  { id: 'notifications', label: 'Notifications' },
]

const TIMEZONE_OPTIONS = [
  { value: 'utc', label: 'UTC' },
  { value: 'america-new-york', label: 'America/New York' },
  { value: 'america-los-angeles', label: 'America/Los Angeles' },
  { value: 'europe-london', label: 'Europe/London' },
  { value: 'europe-paris', label: 'Europe/Paris' },
  { value: 'asia-tokyo', label: 'Asia/Tokyo' },
]

export function SettingsForm() {
  const [tab, setTab] = createSignal('profile')
  const [saved, setSaved] = createSignal(false)

  const [name, setName] = createSignal('Caelan Torchward')
  const [email, setEmail] = createSignal('caelan@torchui.dev')
  const [timezone, setTimezone] = createSignal('america-new-york')

  const [currentPassword, setCurrentPassword] = createSignal('')
  const [newPassword, setNewPassword] = createSignal('')
  const [confirmPassword, setConfirmPassword] = createSignal('')

  const [emailNotifs, setEmailNotifs] = createSignal(true)
  const [slackNotifs, setSlackNotifs] = createSignal(false)
  const [weeklyDigest, setWeeklyDigest] = createSignal(true)
  const [mentions, setMentions] = createSignal(true)

  async function handleSave(e: SubmitEvent) {
    e.preventDefault()
    await new Promise((r) => setTimeout(r, 800))
    setSaved(true)
    setTimeout(() => setSaved(false), 3000)
  }

  return (
    <div class="w-full max-w-2xl mx-auto">
      <Tabs tabs={TABS} value={tab()} onValueChange={setTab} />

      <Show when={saved()}>
        <Alert status="success" class="mb-4">Settings saved successfully.</Alert>
      </Show>

      <Show when={tab() === 'profile'}>
        <Form onSubmit={handleSave}>
          <Section title="Personal Information" titleClass="text-base font-semibold text-ink-900">
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <Input label="Full name" value={name()} onValueChange={setName} required />
              <Input label="Email" type="email" value={email()} onValueChange={setEmail} required />
            </div>
            <div class="mt-4">
              <Select label="Timezone" options={TIMEZONE_OPTIONS} value={timezone()} onValueChange={setTimezone} />
            </div>
          </Section>
          <div class="flex justify-end">
            <Button type="submit" variant="primary">Save changes</Button>
          </div>
        </Form>
      </Show>

      <Show when={tab() === 'security'}>
        <Form onSubmit={handleSave}>
          <Section title="Change Password" titleClass="text-base font-semibold text-ink-900">
            <div class="mt-4 flex flex-col gap-4">
              <Input label="Current password" type="password" placeholder="••••••••" value={currentPassword()} onValueChange={setCurrentPassword} required />
              <Input label="New password" type="password" placeholder="Choose a strong password" value={newPassword()} onValueChange={setNewPassword} required />
              <Input label="Confirm new password" type="password" placeholder="Repeat new password" value={confirmPassword()} onValueChange={setConfirmPassword} required />
            </div>
          </Section>
          <div class="flex justify-end">
            <Button type="submit" variant="primary">Update password</Button>
          </div>
        </Form>
      </Show>

      <Show when={tab() === 'notifications'}>
        <Form onSubmit={handleSave}>
          <Section title="Notification Preferences" titleClass="text-base font-semibold text-ink-900">
            <Card variant="flat" class="mt-4 divide-y divide-surface-border">
              <div class="flex items-center justify-between px-4 py-3">
                <div>
                  <p class="text-sm font-medium text-ink-900">Email notifications</p>
                  <p class="text-xs text-ink-500">Receive updates to your inbox</p>
                </div>
                <Switch checked={emailNotifs()} onValueChange={setEmailNotifs} />
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <div>
                  <p class="text-sm font-medium text-ink-900">Slack notifications</p>
                  <p class="text-xs text-ink-500">Get pinged in your Slack workspace</p>
                </div>
                <Switch checked={slackNotifs()} onValueChange={setSlackNotifs} />
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <div>
                  <p class="text-sm font-medium text-ink-900">Weekly digest</p>
                  <p class="text-xs text-ink-500">A summary of activity every Monday</p>
                </div>
                <Switch checked={weeklyDigest()} onValueChange={setWeeklyDigest} />
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <div>
                  <p class="text-sm font-medium text-ink-900">@mentions</p>
                  <p class="text-xs text-ink-500">Notify me when I am mentioned</p>
                </div>
                <Switch checked={mentions()} onValueChange={setMentions} />
              </div>
            </Card>
          </Section>
          <div class="flex justify-end">
            <Button type="submit" variant="primary">Save preferences</Button>
          </div>
        </Form>
      </Show>
    </div>
  )
}`;function Hle(){return r(fe,{title:"Settings Form",description:"A tabbed settings panel with Profile, Security, and Notifications tabs. Shows how to combine Tabs with conditional Show rendering, Form, Select, and Switch toggles.",get children(){return r(I,{id:"preview",title:"Preview",description:"Switch between tabs to see Profile (name/email/timezone), Security (password change), and Notifications (toggle switches).",code:jle,exampleWidth:"2xl",get children(){return r(Ule,{})}})}})}var Kle=p('<span class="text-base font-semibold text-ink-900">Create task'),Wle=p('<div class="flex justify-end gap-2">');const Gle=[{value:"low",label:"Low"},{value:"medium",label:"Medium"},{value:"high",label:"High"},{value:"urgent",label:"Urgent"}];function qle(){const[t,e]=D(!1),[n,a]=D(!1),[o,l]=D(""),[s,c]=D(""),[d,u]=D("medium");function h(){l(""),c(""),u("medium")}async function g(m){m.preventDefault(),a(!0),await new Promise(b=>setTimeout(b,1e3)),a(!1),e(!1),h()}return[r(H,{variant:"primary",onClick:()=>e(!0),children:"Create task"}),r(Fr,{get open(){return t()},onClose:()=>e(!1),onCloseComplete:h,size:"sm",showCloseButton:!0,get header(){return Kle()},get footer(){return(()=>{var m=Wle();return i(m,r(H,{variant:"outlined",onClick:()=>e(!1),children:"Cancel"}),null),i(m,r(H,{variant:"primary",get loading(){return n()},onClick:()=>{const b=document.querySelector("[data-task-form]");b==null||b.requestSubmit()},children:"Create task"}),null),m})()},get children(){return r(er,{"data-task-form":!0,onSubmit:g,class:"gap-4",get children(){return[r(Te,{label:"Title",placeholder:"Short, descriptive task name",get value(){return o()},onValueChange:l,required:!0}),r($r,{label:"Description",placeholder:"What needs to be done?",get value(){return s()},onValueChange:c,rows:3}),r(ft,{label:"Priority",options:Gle,get value(){return d()},onValueChange:u})]}})}})]}const Yle=`import { createSignal } from 'solid-js'
import { Dialog, Form } from '@torch-ui/solid/layout'
import { Input, TextArea, Select } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'

const PRIORITY_OPTIONS = [
  { value: 'low', label: 'Low' },
  { value: 'medium', label: 'Medium' },
  { value: 'high', label: 'High' },
  { value: 'urgent', label: 'Urgent' },
]

export function FormDialog() {
  const [open, setOpen] = createSignal(false)
  const [loading, setLoading] = createSignal(false)

  const [title, setTitle] = createSignal('')
  const [description, setDescription] = createSignal('')
  const [priority, setPriority] = createSignal('medium')

  function reset() {
    setTitle('')
    setDescription('')
    setPriority('medium')
  }

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault()
    setLoading(true)
    await new Promise((r) => setTimeout(r, 1000))
    setLoading(false)
    setOpen(false)
    reset()
  }

  return (
    <>
      <Button variant="primary" onClick={() => setOpen(true)}>
        Create task
      </Button>

      <Dialog
        open={open()}
        onClose={() => setOpen(false)}
        onCloseComplete={reset}
        size="sm"
        showCloseButton
        header={<span class="text-base font-semibold text-ink-900">Create task</span>}
        footer={
          <div class="flex justify-end gap-2">
            <Button variant="outlined" onClick={() => setOpen(false)}>Cancel</Button>
            <Button
              variant="primary"
              loading={loading()}
              onClick={() => {
                const form = document.querySelector('[data-task-form]') as HTMLFormElement
                form?.requestSubmit()
              }}
            >
              Create task
            </Button>
          </div>
        }
      >
        <Form data-task-form onSubmit={handleSubmit} class="gap-4">
          <Input label="Title" placeholder="Short, descriptive task name" value={title()} onValueChange={setTitle} required />
          <TextArea label="Description" placeholder="What needs to be done?" value={description()} onValueChange={setDescription} rows={3} />
          <Select label="Priority" options={PRIORITY_OPTIONS} value={priority()} onValueChange={setPriority} />
        </Form>
      </Dialog>
    </>
  )
}`;function Xle(){return r(fe,{title:"Form Dialog",description:"A modal dialog containing a form. Demonstrates using Dialog with a header, footer actions, and an inner Form that submits via requestSubmit(). State is cleared after close via onCloseComplete.",get children(){return r(I,{id:"preview",title:"Preview",description:'Click "Create task" to open the dialog. The form validates required fields; the Cancel button and ✕ both close without saving.',code:Yle,exampleWidth:"sm",get children(){return r(qle,{})}})}})}var Jle=p('<div class="flex h-full flex-col"><div class="border-b border-surface-border px-6 py-4"><h2 class="text-base font-semibold text-ink-900">New project</h2><p class="mt-0.5 text-sm text-ink-500">Fill in the details to create a new project.</p></div><div class="flex-1 overflow-y-auto px-6 py-6">');const Qle=[{value:"active",label:"Active"},{value:"inactive",label:"Inactive"},{value:"pending",label:"Pending review"}],Zle=[{value:"frontend",label:"Frontend"},{value:"backend",label:"Backend"},{value:"design",label:"Design"},{value:"devops",label:"DevOps"},{value:"data",label:"Data"}];function ese(){const[t,e]=D(!1),[n,a]=D(!1),[o,l]=D(""),[s,c]=D(""),[d,u]=D("active"),[h,g]=D([]);function m(){l(""),c(""),u("active"),g([])}async function b(y){y.preventDefault(),a(!0),await new Promise(x=>setTimeout(x,1e3)),a(!1),e(!1),m()}return[r(H,{variant:"primary",onClick:()=>e(!0),children:"New project"}),r(Kn,{get open(){return t()},onSave:()=>{var y;return(y=document.getElementById("project-form"))==null?void 0:y.requestSubmit()},onClose:()=>e(!1),onCloseComplete:m,offset:"4",side:"end",size:"lg",cancelLabel:"Cancel",saveLabel:"Save",noPadding:!0,actionsPosition:"bottom",get children(){var y=Jle(),x=y.firstChild,k=x.nextSibling;return i(k,r(er,{onSubmit:b,id:"project-form",get children(){return[r(Te,{label:"Project name",placeholder:"e.g. Website Redesign",get value(){return o()},onValueChange:l,required:!0}),r($r,{label:"Summary",placeholder:"Brief description of the project goals",get value(){return s()},onValueChange:c,rows:4}),r(ft,{label:"Status",options:Qle,get value(){return d()},onValueChange:u}),r(yn,{label:"Tags",options:Zle,get value(){return h()},onValueChange:g})]}})),y}})]}const tse=`import { createSignal } from 'solid-js'
import { Drawer, Form } from '@torch-ui/solid/layout'
import { Input, TextArea, Select, MultiSelect } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'

const STATUS_OPTIONS = [
  { value: 'active', label: 'Active' },
  { value: 'inactive', label: 'Inactive' },
  { value: 'pending', label: 'Pending review' },
]

const TAG_OPTIONS = [
  { value: 'frontend', label: 'Frontend' },
  { value: 'backend', label: 'Backend' },
  { value: 'design', label: 'Design' },
  { value: 'devops', label: 'DevOps' },
  { value: 'data', label: 'Data' },
]

export function FormDrawer() {
  const [open, setOpen] = createSignal(false)
  const [loading, setLoading] = createSignal(false)

  const [projectName, setProjectName] = createSignal('')
  const [summary, setSummary] = createSignal('')
  const [status, setStatus] = createSignal('active')
  const [tags, setTags] = createSignal<string[]>([])

  function reset() {
    setProjectName('')
    setSummary('')
    setStatus('active')
    setTags([])
  }

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault()
    setLoading(true)
    await new Promise((r) => setTimeout(r, 1000))
    setLoading(false)
    setOpen(false)
    reset()
  }

  return (
    <>
      <Button variant="primary" onClick={() => setOpen(true)}>New project</Button>

      <Drawer
        open={open()}
        onClose={() => setOpen(false)}
        onCloseComplete={reset}
        side="end"
        size="md"
        showCloseButton
      >
        <div class="flex h-full flex-col">
          <div class="border-b border-surface-border px-6 py-4">
            <h2 class="text-base font-semibold text-ink-900">New project</h2>
            <p class="mt-0.5 text-sm text-ink-500">Fill in the details to create a new project.</p>
          </div>
          <div class="flex-1 overflow-y-auto px-6 py-6">
            <Form onSubmit={handleSubmit} id="project-form">
              <Input label="Project name" placeholder="e.g. Website Redesign" value={projectName()} onValueChange={setProjectName} required />
              <TextArea label="Summary" placeholder="Brief description of the project goals" value={summary()} onValueChange={setSummary} rows={4} />
              <Select label="Status" options={STATUS_OPTIONS} value={status()} onValueChange={setStatus} />
              <MultiSelect label="Tags" options={TAG_OPTIONS} value={tags()} onValueChange={setTags} />
            </Form>
          </div>
          <div class="border-t border-surface-border px-6 py-4">
            <div class="flex justify-end gap-2">
              <Button variant="outlined" onClick={() => setOpen(false)}>Cancel</Button>
              <Button variant="primary" loading={loading()} type="submit" form="project-form">
                Create project
              </Button>
            </div>
          </div>
        </div>
      </Drawer>
    </>
  )
