@import "@torch-ui/solid/styles/theme.css";

@source "../node_modules/@torch-ui/solid/dist";

/* Override seed variables in :root — NOT inside @theme */
:root {
  --primary: #ff7547;
}`,RU=`:root {
  --primary:       #F74E28; /* brand — all primary-50…950 derive from this */
  --success:       #2CA748;
  --warning:       #DC9A16;
  --danger:        #E83535;
  --info:          #2195E8;

  --ink-light:     #18181c; /* text seed for light mode */
  --ink-dark:      #f0f0f2; /* text seed for dark mode  */
  --surface-light: #fdfdfd; /* background seed for light mode */
  --surface-dark:  #020b13; /* background seed for dark mode  */
}`,VU=`/* Use @theme extend — NOT bare @theme, which resets all defaults */
@theme extend {
  --color-brand-50:  #fdf4ff;
  --color-brand-100: #fae8ff;
  --color-brand-200: #f5d0fe;
  --color-brand-300: #e879f9;
  --color-brand-500: #a855f7;
  --color-brand-700: #7e22ce;
  --color-brand-900: #581c87;
}

/* Now use as normal Tailwind utilities */
/* bg-brand-50  text-brand-700  border-brand-200 ... */`,BU=`:root {
  /* Resize ALL interactive components at each size in one place */
  --torch-h-xs: 1.75rem; /* 28px — h-7  */
  --torch-h-sm: 2rem;    /* 32px — h-8  */
  --torch-h-md: 2.25rem; /* 36px — h-9  (default) */
