const itemOptions: AutocompleteOption[] = [
  { value: 'weapon', label: 'Weapon' },
  { value: 'armor', label: 'Armor' },
  { value: 'potion', label: 'Potion' },
  { value: 'scroll', label: 'Scroll' },
  { value: 'ring', label: 'Ring' },
]

const [value, setValue] = createSignal('')
const [added, setAdded] = createSignal<string[]>([])

const handleAdd = () => {
  const v = value()
  if (v && !added().includes(v)) setAdded((prev) => [...prev, v])
}

<div class="w-full max-w-md space-y-2">
  <div class="text-sm font-semibold text-ink-900">Add item</div>
  <div class="flex items-center gap-2">
    <Autocomplete
      options={itemOptions}
      value={value()}
      onValueChange={setValue}
      placeholder="Search inventory..."
      class="flex-1 min-w-0"
    />
    <Button variant="outlined" size="md" startIcon={<Plus class="h-4 w-4" />} onClick={handleAdd}>
      Add
    </Button>
  </div>
  {added().length > 0 && <p class="text-sm text-ink-600">Added: {added().join(', ')}</p>}
