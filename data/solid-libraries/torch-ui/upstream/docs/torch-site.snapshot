</div>`,QW=`import { createSignal } from 'solid-js'
import { Checkbox } from '@torch-ui/solid/forms'

const [checked, setChecked] = createSignal([false, false])

const allChecked = () => checked()[0] && checked()[1]
const someChecked = () => checked()[0] || checked()[1]
const indeterminate = () => someChecked() && !allChecked()

const handleParent = (v: boolean) => {
  setChecked([v, v])
}
const handleChild = (i: 0 | 1) => (v: boolean) => {
  const next = [...checked()] as [boolean, boolean]
  next[i] = v
  setChecked(next)
}

<div class="flex flex-col items-start gap-2">
  <Checkbox
    checked={allChecked()}
    indeterminate={indeterminate()}
    onValueChange={handleParent}
    label="All equipment"
  />
  <div class="ml-6 flex flex-col gap-2">
    <Checkbox checked={checked()[0]} onValueChange={handleChild(0)} label="Sword & Shield" />
    <Checkbox checked={checked()[1]} onValueChange={handleChild(1)} label="Arcane Tome" />
  </div>
