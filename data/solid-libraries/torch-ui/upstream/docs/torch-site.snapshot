:root {
  --code-token-default: #1e293b;
  --code-token-comment: #94a3b8;
  --code-token-punctuation: #64748b;
  --code-token-keyword: #7c3aed;
  --code-token-function: #2563eb;
  --code-token-string: #059669;
  --code-token-number: #d97706;
  --code-token-property: #dc2626;
  --code-token-operator: #0891b2;
