raphy/heading":"Semantic heading elements (h1–h6) with consistent sizing scale.","/typography/code":"Inline code with optional syntax highlighting and a copy button.","/typography/block-quote":"A styled block for quoted text with an optional citation source.","/actions/button":"Clickable element for triggering actions with variants, sizes, icons, and loading state.","/actions/button-group":"Groups related buttons together including split button and segmented support.","/actions/copy":"Trigger that copies text to the clipboard with visual confirmation feedback.","/actions/link":"Styled anchor element with optional external link indicator and icon.","/actions/dark-mode-toggle":"Toggle switch for switching between light and dark color scheme.","/forms/input":"Text field with label, adornments, helper text, error state, and compact mode.","/forms/number-field":"Numeric input with increment and decrement step controls and min/max bounds.","/forms/code-input":"Segmented input for OTP codes and short verification strings.","/forms/text-area":"Multi-line text input with auto-resize and optional character limit.","/forms/select":"Dropdown for selecting a single option from a list with search support.","/forms/multi-select":"Dropdown for selecting multiple options displayed as removable tags.","/forms/autocomplete":"Text input that suggests matching options from a list as you type.","/forms/checkbox":"Binary input with support for indeterminate state and label.","/forms/radio-group":"Group of radio options where only one can be selected at a time.","/forms/switch":"Toggle for switching between on and off states with icon variant.","/forms/slider":"Drag handle for selecting a numeric value or range along a track.","/forms/reorderable-list":"List where items can be reordered by drag and drop or keyboard.","/forms/date-picker":"Date input with a calendar popover for single date selection.","/forms/date-range-picker":"Dual calendar picker for selecting a start and end date range.","/forms/color-picker":"Color input with swatch preview, hex input, and optional popover.","/forms/file-upload":"File input supporting drag-and-drop with preview and multiple files.","/forms/field-picker":"Picker for selecting fields or columns, used inside filter builders.","/forms/relative-date":'Picker for selecting relative date ranges like "last 7 days" or "this month".',"/layout/container":"Max-width wrapper for centering and constraining page content.","/layout/grid":"Responsive column grid for laying out content with configurable columns.","/layout/section":"Page section with optional title, description, and body slot.","/layout/card":"Container for grouping related content with optional image, header, and footer.","/layout/divider":"Horizontal or vertical separator line for dividing content areas.","/layout/page-heading":"Page-level title and description block used at the top of views.","/layout/collapsible":"Single section that can be expanded or collapsed with animation.","/layout/accordion":"List of headings that each expand to reveal a panel of content.","/layout/code-block":"Syntax-highlighted code block with copy button and line numbers.","/layout/inline":"Horizontal flow layout for inline elements with gap and wrap control.","/layout/form":"Form wrapper with legend, field grid, and error summary support.","/layout/wizard":"Stepper component for guiding users through multi-step flows.","/layout/prompt-with-action":"Card section with a headline, description, and call-to-action button.","/navigation/breadcrumbs":"Trail of links showing the current page location in the hierarchy.","/navigation/navigation-menu":"Horizontal nav bar with animated dropdown sub-menus.","/navigation/mega-menu":"Wide multi-column dropdown navigation panel with sections and featured cards.","/navigation/sidebar":"Side navigation panel with groups, icons, badges, and collapsible sections.","/navigation/dropdown-menu":"Button that opens a contextual menu of selectable actions.","/navigation/tabs":"Tabbed interface for switching between labelled content panels.","/navigation/pagination":"Page controls for navigating between pages of content.","/navigation/view-switcher":"Control for toggling between grid, list, and other view layouts.","/overlays/dialog":"Modal with backdrop overlay that traps focus and scrolls the page.","/overlays/drawer":"Panel that slides in from the edge of the screen with a close button.","/overlays/context-menu":"Right-click or long-press menu with actions and keyboard navigation.","/overlays/popover":"Floating content panel anchored to a trigger element.","/overlays/hover-card":"Rich preview card that appears on hover over a trigger element.","/overlays/tooltip":"Short hint text that appears on hover or keyboard focus.","/overlays/search-palette":"Command palette for searching docs and navigating quickly with keyboard.","/feedback/alert":"Inline message for communicating status, warnings, or success feedback.","/feedback/alert-dialog":"Confirmation dialog that blocks interaction until user explicitly acts.","/feedback/toast":"Temporary notification that appears and auto-dismisses after a timeout.","/feedback/progress":"Progress bar showing the completion percentage of a task.","/feedback/loading":"Spinner and overlay variants for indicating async loading state.","/feedback/skeleton":"Placeholder shape shown while content is loading to reduce layout shift.","/feedback/password-strength":"Visual indicator of password complexity with color-coded segments.","/data-display/image":"Image with lazy loading skeleton, error fallback src, and overlay slots.","/data-display/video":"Video player with aspect ratio control, autoplay, and error fallback.","/data-display/avatar":"User image or generated initials with badge, ring, and group support.","/data-display/persona":"Avatar paired with a name, subtitle, and optional metadata.","/data-display/stat":"Metric displayed with a label, value, trend, and optional sparkline.","/data-display/tag":"Small label or chip for categories, status dots, and metadata.","/data-display/badge":"Count or status indicator that attaches to another element.","/data-display/color-swatch":"Small color preview circle with optional selection and label.","/data-display/carousel":"Horizontally scrollable content area with arrow and dot navigation.","/data-display/table":"Semantic table primitives for structured data with sort indicators.","/data-display/table-panel":"Table inside a panel with optional header actions and pagination.","/data-display/table-view":"Table with built-in column filter, layout controls, and row actions.","/data-display/datatable":"Full-featured data table with sorting, filtering, and row selection.","/data-display/timeline":"Vertical list of time-ordered events with icons, status, and metadata.","/data-display/tree-view":"Hierarchical list of expandable and selectable tree nodes.","/data-display/empty-state":"Placeholder displayed when a list or data view has no results.","/data-display/kbd":"Keyboard key labels for documenting shortcuts and hotkeys.","/charts/bar":"Bar chart with grouped, stacked, and horizontal layout variants.","/charts/line":"Line and area chart with fill, tension, and stepped line support.","/charts/pie":"Pie and doughnut chart with multi-series and legend support.","/charts/sparkline":"Small inline line chart for showing data trends at a glance.","/charts/other":"Radar, polar area, scatter, and bubble chart types.","/charts/options":"Shared Chart.js configuration for titles, legends, tooltips, and scales.","/utilities/cn":"Utility function for merging and conditionally applying Tailwind class names.","/utilities/merge-refs":"Utility for merging multiple SolidJS refs onto a single DOM node.","/utilities/i18n":"Internationalization helpers for locale-aware formatting and text.","/utilities/component-size":"ComponentSize type and size scale used across all sized components.","/utilities/create-sortable-drag":"Hook for build