import { createSortableDrag } from '@torch-ui/solid'
import { GripVertical } from 'lucide-solid'

const [items, setItems] = createSignal([
  { id: '1', label: 'First item' },
  { id: '2', label: 'Second item' },
  { id: '3', label: 'Third item' },
])

const drag = createSortableDrag({
  items,
  onReorder: (ids) => {
    setItems((prev) => ids.map((id) => prev.find((i) => i.id === id)!))
  },
})

<ul data-sortable-container>
  <For each={items()}>
    {(item) => (
      <li
        data-sortable-id={item.id}
        style={{
          transform: drag.getTransform(item.id),
          opacity: drag.activeId() === item.id ? 0.4 : 1,
          transition: drag.isDragging() ? 'transform 150ms ease' : '',
        }}
        class="flex items-center gap-2 rounded-lg border border-surface-border bg-surface-raised px-3 py-2 text-sm"
      >
        <button
          type="button"
          class="cursor-grab touch-none text-ink-400 hover:text-ink-700"
          onPointerDown={(e) => drag.handlePointerDown(item.id, e)}
          aria-label="Drag to reorder"
        >
          <GripVertical class="h-4 w-4" />
        </button>
        {item.label}
      </li>
    )}
  </For>
</ul>`,vie=`// The container MUST have data-sortable-container
