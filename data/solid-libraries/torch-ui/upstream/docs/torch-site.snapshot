{/* Outlined: grouped control (ghost looks the same in a group) */}
<ButtonGroup variant="outlined">
  <Button variant="outlined" disableElevation>Sword</Button>
  <Button variant="outlined" disableElevation>Shield</Button>
  <Button variant="outlined" disableElevation>Bow</Button>
</ButtonGroup>

{/* Filled: use filled prop + variant on each button */}
<ButtonGroup filled>
  <Button variant="primary" disableElevation>Cast Spell</Button>
  <Button variant="primary" disableElevation>Empower</Button>
</ButtonGroup>
<ButtonGroup filled>
  <Button variant="danger" disableElevation>Execute</Button>
  <Button variant="danger" disableElevation>Banish</Button>
</ButtonGroup>

`,KH=`import { Button, ButtonGroup } from '@torch-ui/solid/actions'
