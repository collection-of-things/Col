import { Card, Divider, Form } from '@torch-ui/solid/layout'
import { Input, Checkbox } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'

export function LoginForm() {
  const [email, setEmail] = createSignal('')
  const [password, setPassword] = createSignal('')
  const [remember, setRemember] = createSignal(false)
  const [loading, setLoading] = createSignal(false)

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault()
    setLoading(true)
    await new Promise((r) => setTimeout(r, 1500))
    setLoading(false)
  }

  return (
    <Card class="w-full max-w-sm mx-auto">
      <Card.Body>
        <div class="mb-6">
          <h2 class="text-xl font-bold text-ink-900">Sign in</h2>
          <p class="mt-1 text-sm text-ink-600">Welcome back. Enter your credentials to continue.</p>
        </div>
        <Form onSubmit={handleSubmit} class="gap-4">
          <Input
            label="Email"
            type="email"
            placeholder="you@example.com"
            value={email()}
            onValueChange={setEmail}
            required
          />
          <Input
            label="Password"
            type="password"
            placeholder="••••••••"
            value={password()}
            onValueChange={setPassword}
            required
          />
          <div class="flex items-center justify-between">
            <Checkbox
              label="Remember me"
              checked={remember()}
              onValueChange={setRemember}
            />
            <a href="#" class="text-sm text-primary-600 hover:underline">
              Forgot password?
            </a>
          </div>
          <Button type="submit" variant="primary" fullWidth loading={loading()}>
            Sign in
          </Button>
        </Form>
        <Divider label="or continue with" class="my-4" />
        <Button variant="outlined" fullWidth>
          Continue with Google
        </Button>
      </Card.Body>
    </Card>
  )
}`;function $le(){return r(fe,{title:"Login Form",description:"A sign-in form with email, password, remember me checkbox, and social login divider. Uses Card, Form, Input, Checkbox, Divider, and Button.",get children(){return r(I,{id:"preview",title:"Preview",description:"Copy the source below into your project and wire up handleSubmit to your auth logic.",code:Sle,exampleWidth:"sm",get children(){return r(kle,{})}})}})}var _le=p('<div class=mb-6><h2 class="text-xl font-bold text-ink-900">Create an account</h2><p class="mt-1 text-sm text-ink-600">Get started for free. No credit card required.'),Tle=p('<div class="flex flex-col gap-1.5">'),Dle=p('<p class="mt-4 text-center text-sm text-ink-500">Already have an account? <a href=# class="text-primary-600 hover:underline">Sign in');function Ile(){const[t,e]=D(""),[n,a]=D(""),[o,l]=D(""),[s,c]=D(!1),[d,u]=D(!1);async function h(g){g.preventDefault(),s()&&(u(!0),await new Promise(m=>setTimeout(m,1500)),u(!1))}return r(De,{class:"w-full max-w-sm mx-auto",get children(){return r(De.Body,{get children(){return[_le(),r(er,{onSubmit:h,class:"gap-4",get children(){return[r(Te,{label:"Full name",placeholder:"Caelan Torchward",get value(){return t()},onValueChange:e,required:!0}),r(Te,{label:"Email",type:"email",placeholder:"you@example.com",get value(){return n()},onValueChange:a,required:!0}),(()=>{var g=Tle();return i(g,r(Te,{label:"Password",type:"password",placeholder:"Choose a strong password",get value(){return o()},onValueChange:l,required:!0}),null),i(g,r(ca,{get password(){return o()}}),null),g})(),r(Lt,{label:"I agree to the Terms of Service and Privacy Policy",get checked(){return s()},onValueChange:c}),r(H,{type:"submit",variant:"primary",fullWidth:!0,get loading(){return d()},get disabled(){return!s()},children:"Create account"})]}}),Dle()]}})}})}const Ale=`import { createSignal } from 'solid-js'
import { Card, Form } from '@torch-ui/solid/layout'
import { Input, Checkbox } from '@torch-ui/solid/forms'
import { Button } from '@torch-ui/solid/actions'
import { PasswordStrengthIndicator } from '@torch-ui/solid/feedback'

export function RegisterForm() {
  const [name, setName] = createSignal('')
  const [email, setEmail] = createSignal('')
  const [password, setPassword] = createSignal('')
  const [agreed, setAgreed] = createSignal(false)
  const [loading, setLoading] = createSignal(false)

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault()
    if (!agreed()) return
    setLoading(true)
    await new Promise((r) => setTimeout(r, 1500))
    setLoading(false)
  }

  return (
    <Card class="w-full max-w-sm mx-auto">
      <Card.Body>
        <div class="mb-6">
          <h2 class="text-xl font-bold text-ink-900">Create an account</h2>
          <p class="mt-1 text-sm text-ink-600">Get started for free. No credit card required.</p>
        </div>
        <Form onSubmit={handleSubmit} class="gap-4">
          <Input
            label="Full name"
            placeholder="Caelan Torchward"
            value={name()}
            onValueChange={setName}
            required
          />
          <Input
            label="Email"
            type="email"
            placeholder="you@example.com"
            value={email()}
            onValueChange={setEmail}
            required
          />
          <div class="flex flex-col gap-1.5">
            <Input
              label="Password"
              type="password"
              placeholder="Choose a strong password"
              value={password()}
              onValueChange={setPassword}
              required
            />
            <PasswordStrengthIndicator password={password()} />
          </div>
          <Checkbox
            label="I agree to the Terms of Service and Privacy Policy"
            checked={agreed()}
            onValueChange={setAgreed}
          />
          <Button
            type="submit"
            variant="primary"
            fullWidth
            loading={loading()}
            disabled={!agreed()}
          >
            Create account
          </Button>
        </Form>
        <p class="mt-4 text-center text-sm text-ink-500">
          Already have an account?{' '}
          <a href="#" class="text-primary-600 hover:underline">Sign in</a>
        </p>
      </Card.Body>
    </Card>
  )
}`;function Ele(){return r(fe,{title:"Register Form",description:"A sign-up form with name, email, password strength indicator, and terms-of-service checkbox. The submit button is disabled until the user agrees to terms.",get children(){return r(I,{id:"preview",title:"Preview",description:"Wire handleSubmit to your registration API. PasswordStrengthIndicator gives live feedback as the user types.",code:Ale,exampleWidth:"sm",get children(){return r(Ile,{})}})}})}var Ple=p('<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">'),Mle=p("<div class=mt-4>"),Tu=p('<div class="flex justify-end">'),Ole=p('<div class="mt-4 flex flex-col gap-4">'),Lle=p('<div class="flex items-center justify-between px-4 py-3"><div><p class="text-sm font-medium text-ink-900">Email notifications</p><p class="text-xs text-ink-500">Receive updates to your inbox'),Rle=p('<div class="flex items-center justify-between px-4 py-3"><div><p class="text-sm font-medium text-ink-900">Slack notifications</p><p class="text-xs text-ink-500">Get pinged in your Slack workspace'),Vle=p('<div class="flex items-center justify-between px-4 py-3"><div><p class="text-sm font-medium text-ink-900">Weekly digest</p><p class="text-xs text-ink-500">A summary of activity every Monday'),Ble=p('<div class="flex items-center justify-between px-4 py-3"><div><p class="text-sm font-medium text-ink-900">@mentions</p><p class="text-xs text-ink-500">Notify me when I am mentioned'),Fle=p('<div class="w-full max-w-2xl mx-auto">');const zle=[{id:"profile",label:"Profile"},{id:"security",label:"Security"},{id:"notifications",label:"Notifications"}],Nle=[{value:"utc",label:"UTC"},{value:"america-new-york",label:"America/New York"},{value:"america-los-angeles",label:"America/Los Angeles"},{value:"europe-london",label:"Europe/London"},{value:"europe-paris",label:"Europe/Paris"},{value:"asia-tokyo",label:"Asia/Tokyo"}];function Ule(){const[t,e]=D("profile"),[n,a]=D(!1),[o,l]=D("Caelan Torchward"),[s,c]=D("caelan@torchui.dev"),[d,u]=D("