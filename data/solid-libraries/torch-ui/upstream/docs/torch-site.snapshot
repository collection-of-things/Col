const [cards, setCards] = createSignal<Card[]>([
  { id: '1', title: 'Slay the Goblin King',   status: 'open'   },
  { id: '2', title: 'Map the Greywood',        status: 'open'   },
  { id: '3', title: 'Recover stolen grain',    status: 'active' },
])

const handleMove = (e: BoardMoveEvent) => {
  setCards(prev =>
    prev.map(c => c.id === e.cardId ? { ...c, status: e.toColumnId as Status } : c)
  )
}

