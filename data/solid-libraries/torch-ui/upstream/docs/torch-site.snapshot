import { Pagination } from '@torch-ui/solid/navigation'
import { createSignal } from 'solid-js'

const [page, setPage] = createSignal(1)
const [pageSize, setPageSize] = createSignal(10)

<div class={cn('overflow-hidden', TABLE_CONTAINER_CLASS)}>
  <Table>...</Table>
  <Pagination
    totalItems={totalItems}
    totalPages={Math.ceil(totalItems / pageSize())}
    page={page()}
    pageSize={pageSize()}
    onPageChange={setPage}
    onPageSizeChange={setPageSize}
    maxPages={0}
    class="border-t border-surface-border bg-surface-raised px-6 py-3"
  />
</div>`,pae=`import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from '@torch-ui/solid/data-display'
import { Avatar } from '@torch-ui/solid/data-display'
import { Button } from '@torch-ui/solid/actions'
import { Tag } from '@torch-ui/solid/data-display'
import { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem } from '@torch-ui/solid/navigation'

<Table>
  <TableHeader><TableRow><TableHead>Name</TableHead><TableHead>Role</TableHead><TableHead>Status</TableHead><TableHead>Actions</TableHead></TableRow></TableHeader>
  <TableBody>
    {rows.map((row) => (
      <TableRow>
        <TableCell>
          <div class="flex items-center gap-3">
            <Avatar name={row.name} imageUrl={row.imageUrl} size="sm" />
            <div><p class="font-medium">{row.name}</p><p class="text-xs text-ink-500">{row.email}</p></div>
          </div>
        </TableCell>
        <TableCell>...</TableCell>
        <TableCell><Tag variant="success" size="sm">{row.status}</Tag></TableCell>
        <TableCell><Button variant="ghost" size="sm" iconOnly icon={<Eye />} aria-label="View" />...</TableCell>
      </TableRow>
    ))}
  </TableBody>
</Table>`,hae=`import { Table, TableBody, TableRow, TableCell, TABLE_CONTAINER_CLASS } from '@torch-ui/solid/data-display'

<div class={cn('overflow-x-auto', TABLE_CONTAINER_CLASS)}>
  <Table>
    <TableBody>
      {rows.map((row) => (
        <TableRow>
          <TableCell>{row.name}</TableCell>
          <TableCell>{row.role}</TableCell>
          <TableCell>{row.status}</TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</div>`,gae=`const [selected, setSelected] = createSignal<string | null>(null)

<TableRow
  role="button"
  tabIndex={0}
  class={selected() === row.id ? 'cursor-pointer bg-primary-50 dark:bg-primary-500/20' : 'cursor-pointer'}
  onClick={() => setSelected(row.id)}
  onKeyDown={(e) => e.key === 'Enter' && setSelected(row.id)}
>
  <TableCell>...</TableCell>
</TableRow>`,mae=`const [selected, setSelected] = createSignal<Set<string>>(new Set())

<TableHeader>
  <TableRow>
    <TableHead>
      <Checkbox
        checked={selected().size === rows.length}
        indeterminate={selected().size > 0 && selected().size < rows.length}
        onChange={(e) => e.target.checked ? setSelected(new Set(rows.map(r => r.id))) : setSelected(new Set())}
        aria-label="Select all"
      />
    </TableHead>
    ...
  </TableRow>
</TableHeader>
<TableBody>
  {rows.map((row) => (
    <TableRow>
      <TableCell>
        <Checkbox
          checked={selected().has(row.id)}
          onChange={(e) => { const next = new Set(selected()); e.target.checked ? next.add(row.id) : next.delete(row.id); setSelected(next) }}
        />
      </TableCell>
      ...
    </TableRow>
  ))}
</TableBody>`,fae=`const [sortColumn, setSortColumn] = createSignal('name')
const [sortDir, setSortDir] = createSignal<'asc' | 'desc'>('asc')
const sorted = createMemo(() => [...items].sort((a, b) => {
  const cmp = a[sortColumn()].localeCompare(b[sortColumn()])
  return sortDir() === 'asc' ? cmp : -cmp
}))

<TableHead>
  <button type="button" onClick={() => toggleSort('name')}>
    Name {sortColumn() === 'name' && (sortDir() === 'asc' ? '\\u2191' : '\\u2193')}
  </button>
</TableHead>`,bae=`const [page, setPage] = createSignal(1)
