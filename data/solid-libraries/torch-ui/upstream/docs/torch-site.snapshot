  onRemove={onRemove}
  variant="dropzone"
  actions={
    <>
      <Button variant="ghost" onClick={onClose}>Done</Button>
      <Button variant="primary" onClick={handleUpload}>Upload</Button>
    </>
  }
/>`,Lq=`import { FileUpload, type FileUploadItem } from '@torch-ui/solid/forms'

<FileUpload
