import type { TableViewConfig, ViewConfig } from '@torch-ui/solid/layout'

const config: TableViewConfig = {
  systemDefaultViewId: 'all',
  defaultViews: [
    { id: 'all', label: 'All', fields: ['name', 'role'], groupBy: 'none', filters: emptyFilterGroup(), scope: 'tenant', pinned: true },
    { id: 'active', label: 'Active', fields: ['name', 'role'], groupBy: 'none', filters: emptyFilterGroup(), scope: 'tenant' },
  ],
  allFields: [{ id: 'name', label: 'Name', structured: false }, { id: 'role', label: 'Role', structured: false }],
  filterFields: [{ id: 'status', label: 'Status', type: 'select', options: [{ value: 'active', label: 'Active' }] }],
  getOperatorsForType: (type) => (type === 'select' ? [{ value: 'eq', label: 'is' }, { value: 'in', label: 'is any of' }] : [{ value: 'contains', label: 'contains' }]),
  initialFields: ['name', 'role'],
  rowCount: 0,
}

<TableView config={config} toolbar={(api) => (
  <Button variant="outlined" size="sm" leftIcon={<Filter />} onClick={api.openFilters}>Filters</Button>
