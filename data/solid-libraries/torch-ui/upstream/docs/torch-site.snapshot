      helperText: 'Add more character types.' 
    },
    good: { 
      label: 'Strong', 
      helperText: 'Looking good!' 
    },
    excellent: { 
      label: 'Fortress!', 
      helperText: 'Unbreakable password!' 
    }
  }}
/>`,Dee=`import { PasswordStrengthIndicator, type PasswordStrength } from '@torch-ui/solid/feedback'

