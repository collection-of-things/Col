const colors = [
  { hex: '#3b82f6', name: 'Blue' },
  { hex: '#22c55e', name: 'Green' },
  { hex: '#ef4444', name: 'Red' },
]

<div class="flex flex-wrap gap-4">
  {colors.map(({ hex, name }) => (
    <div class="flex flex-col items-center gap-1.5">
      <ColorSwatch value={hex} class="h-10 w-10" />
      <span class="text-xs font-mono text-ink-600">{hex}</span>
      <span class="text-xs text-ink-500">{name}</span>
    </div>
  ))}
</div>`,Tne=`import { ColorSwatch } from '@torch-ui/solid/data-display'

