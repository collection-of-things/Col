import { DropdownMenuItem } from '@torch-ui/solid/navigation'
import { AlertDialog } from '@torch-ui/solid/overlays'

function MySplitWithDialog() {
  const [dialogOpen, setDialogOpen] = createSignal(false)
  return (
    <>
      <ButtonGroup split>
        <ButtonGroup.Main onClick={() => alert('Equipped!')}>Equip</ButtonGroup.Main>
        <ButtonGroup.Menu>
          {() => (
            <>
              <DropdownMenuItem onSelect={() => setDialogOpen(true)}>Attune Item</DropdownMenuItem>
              <DropdownMenuItem onSelect={() => {}}>Store in Vault</DropdownMenuItem>
            </>
          )}
        </ButtonGroup.Menu>
      </ButtonGroup>
      <AlertDialog
        open={dialogOpen()}
        onOpenChange={setDialogOpen}
        title="Attune to this item?"
        description="Attuning replaces your current attunement slot. You may only be attuned to 3 items at once."
        confirmLabel="Attune"
        onConfirm={() => {}}
      />
    </>
  )
}`,qH=String.raw`import { createSignal } from 'solid-js'
import { ButtonGroup } from '@torch-ui/solid/actions'

function MyToggleSingle() {
  const options = [
    { value: 'attack', label: 'Attack' },
    { value: 'magic', label: 'Magic' },
    { value: 'stealth', label: 'Stealth' },
  ]
  const [value, setValue] = createSignal('magic')
  return (
    <div>
      <ButtonGroup options={options} value={value()} onValueChange={setValue} />
    </div>
  )
}`,YH=String.raw`import { createSignal } from 'solid-js'
