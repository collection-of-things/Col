<Progress value={62} segments={8} aria-label="Strength" />`,Wf=4e3,aee=`import { createSignal, Show } from 'solid-js'
import { Progress } from '@torch-ui/solid/feedback'
import { Button } from '@torch-ui/solid/actions'

const DURATION_MS = 4000

function DurationDemo() {
  const [runId, setRunId] = createSignal(0)
  const [running, setRunning] = createSignal(false)
  const [done, setDone] = createSignal(false)
  let timer: ReturnType<typeof setTimeout>

  const start = () => {
    clearTimeout(timer)
    setRunId((n) => n + 1)
    setRunning(true)
    setDone(false)
    timer = setTimeout(() => { setRunning(false); setDone(true) }, DURATION_MS)
  }

  return (
    <div class="space-y-3">
      <Show when={runId()} keyed>
        {() => <Progress durationMs={DURATION_MS} aria-label="Loading" />}
      </Show>
      <Button size="sm" variant={done() ? 'primary' : 'outlined'} disabled={running()} onClick={start}>
        {done() ? 'Restart' : 'Start'}
      </Button>
    </div>
  )
}`;function oee(){const[t,e]=D(0),[n,a]=D(!1),[o,l]=D(!1);let s;const c=()=>{clearTimeout(s),e(d=>d+1),a(!0),l(!1),s=setTimeout(()=>{a(!1),l(!0)},Wf)};return(()=>{var d=qZ();return i(d,r(O,{get when(){return t()},keyed:!0,children:u=>r($t,{durationMs:Wf,"aria-label":"Loading"})}),null),i(d,r(H,{size:"sm",get variant(){return o()?"primary":"outlined"},get disabled(){return n()},onClick:c,get children(){return o()?"Restart":"Start"}}),null),d})()}function iee(){return r(fe,{title:"Progress",description:"Progress bar for determinate or indeterminate activity. Supports label, size, color, radius, value display, segments, and duration-based animation. Use aria-label when label is not provided.",importSnippet:"import { Progress } from '@torch-ui/solid/feedback'",get children(){return[r(I,{id:"value",title:"Value",description:"Set value (0—100 by default; use minValue/maxValue for other ranges). Use aria-label for accessibility.",code:YZ,get children(){var t=ml();return i(t,r($t,{value:0,"aria-label":"Progress"}),null),i(t,r($t,{value:45,"aria-label":"Progress"}),null),i(t,r($t,{value:100,"aria-label":"Progress"}),null),t}}),r(I,{id:"sizes",title:"Sizes",description:"size: sm | md | lg. Controls track height.",code:XZ,get children(){var t=ml();return i(t,r($t,{value:60,size:"sm","aria-label":"Progress"}),null),i(t,r($t,{value:60,size:"md","aria-label":"Progress"}),null),i(t,r($t,{value:60,size:"lg","aria-label":"Progress"}),null),t}}),r(I,{id:"colors",title:"Colors",description:"color: default | primary | secondary | success | warning | danger.",code:JZ,get children(){var t=ml();return i(t,r($t,{value:50,color:"primary","aria-label":"Progress"}),null),i(t,r($t,{value:50,color:"success","aria-label":"Progress"}),null),i(t,r($t,{value:50,color:"warning","aria-label":"Progress"}),null),i(t,r($t,{value:50,color:"danger","aria-label":"Progress"}),null),t}}),r(I,{id:"indeterminate",title:"Indeterminate",description:"Use isIndeterminate when total progress is unknown. Shows an an