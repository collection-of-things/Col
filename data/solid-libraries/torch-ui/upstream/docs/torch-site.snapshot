import { Heart, Share2 } from 'lucide-solid'

{/* Badge */}
<Image src="..." overlay={<Tag variant="primary" size="sm">New</Tag>} overlayPosition="top-left" />

{/* Hover reveal */}
<Image
  src="..."
  overlay={<div class="bg-black/50 text-white text-sm font-medium">Click to view</div>}
  overlayPosition="full"
  overlayOnHover
/>

{/* Action buttons */}
<Image
  src="..."
  overlay={
    <div class="flex gap-1">
      <button class="rounded bg-white/20 p-1.5 text-white backdrop-blur-sm hover:bg-white/30">
        <Heart class="h-4 w-4" />
      </button>
      <button class="rounded bg-white/20 p-1.5 text-white backdrop-blur-sm hover:bg-white/30">
        <Share2 class="h-4 w-4" />
      </button>
    </div>
  }
  overlayPosition="top-right"
/>

{/* Gradient scrim */}
<Image
  src="..."
  overlay={<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />}
  overlayPosition="full"
/>`,Qte=`import { createSignal } from 'solid-js'
