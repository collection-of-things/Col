import { DataTable, Avatar, Tag, type ColumnDef } from '@torch-ui/solid/data-display'
import { ViewSwitcher, type ViewSwitcherItem } from '@torch-ui/solid/navigation'
import { Button } from '@torch-ui/solid/actions'

const ALL_MEMBERS = [ /* ... your data */ ]

const VIEW_FILTERS = {
  all:     () => true,
  ready:   (m) => m.status === 'Ready',
  resting: (m) => m.status === 'Resting',
  down:    (m) => m.status === 'Unconscious',
}

export function TablePanel() {
  const [activeView, setActiveView] = createSignal('all')
  const rows = createMemo(() => ALL_MEMBERS.filter(VIEW_FILTERS[activeView()]))

  const views = createMemo<ViewSwitcherItem[]>(() => [
    { id: 'all',     label: 'All Members', count: ALL_MEMBERS.length },
    { id: 'ready',   label: 'Ready',       count: ALL_MEMBERS.filter(VIEW_FILTERS.ready).length,   pinned: true },
    { id: 'resting', label: 'Resting',     count: ALL_MEMBERS.filter(VIEW_FILTERS.resting).length },
    { id: 'down',    label: 'Unconscious', count: ALL_MEMBERS.filter(VIEW_FILTERS.down).length },
  ])

  return (
    <div class="overflow-hidden rounded-xl border border-surface-border bg-surface-base">
      <div class="border-b border-surface-border bg-surface-dim/40">
        <ViewSwitcher
          views={views()}
          activeId={activeView()}
          onValueChange={setActiveView}
          variant="embedded"
          class="w-full"
        />
      </div>
      <div class="flex items-center justify-between gap-2 border-b border-surface-border px-4 py-2.5">
        <p class="text-sm text-ink-500">{rows().length} members</p>
        <Button variant="primary" size="sm">Add member</Button>
      </div>
      <DataTable columns={COLUMNS} items={rows()} emptyMessage="No members found" />
    </div>
  )
}`;function Fce(){return r(fe,{title:"Table Panel",description:"A DataTable with a ViewSwitcher tab bar for filtering between saved views. Each tab shows a live count. The toolbar displays the current row count and primary action.",get children(){return r(I,{id:"preview",title:"Preview",description:"Click the tabs to filter between All, Ready, Resting, and Unconscious members. Pinned tabs (Ready) always appear first.",code:Bce,exampleWidth:"full",get children(){return r(Vce,{})}})}})}const Ow="torchui-docs-primary",Lw="torchui-docs-surface-light",Rw="torchui-docs-surface-dark",Vw="torchui-docs-ink-light",Bw="torchui-docs-ink-dark",ds="#F74E28",ud="#fafafa",Ah="#020b13",Eh="#18181c",Ph="#f0f0f2",Mh=["red","yellow","green","cyan","blue","indigo","purple","pink"],Pc={red:{name:"Red",hex:"#ff4141"},yellow:{name:"Yellow",hex:"#ffbe0c"},green:{name:"Green",hex:"#09d33c"},cyan:{name:"Cyan",hex:"#14c4ff"},blue:{name:"Blue",hex:"#0a20eb"},indigo:{name:"Indigo",hex:"#4f46e5"},purple:{name:"Purple",hex:"#8800ff"},pink:{name:"Pink",hex:"#ff227b"}};function us(t,e){if(typeof window>"u")return e;const n=localStorage.getItem(t);return n&&/^#[0-9a-fA-F]{6}$/.test(n.trim())?n.trim():e}function Fl(){return us(Ow,ds)}function Oh(){return us(Lw,ud)}function Fw(){return us(Rw,Ah)}function zw(){return us(Vw,Eh)}function Nw(){return us(Bw,Ph)}function zl(t){if(typeof document>"u")return;const e=t||Fl(),n=document.documentElement;n.style.setProperty("--primary",e),n.style.setProperty("--color-primary-50",`color-mix(in oklch, white 90%, ${e})`),n.style.setProperty("--color-primary-100",`color-mix(in oklch, white 80%, ${e})`),n.style.setProperty("--color-primary-200",`color-mix(in oklch, white 60%, ${e})`),n.style.setProperty("--color-primary-300",`color-mix(in oklch, white 40%, ${e})`),n.style.setProperty("--color-primary-400",`color-mix(in oklch, white 20%, ${e})`),n.style.setProperty("--color-primary-500",e),n.style.setProperty("--color-primary-600",`color-mix(in oklch, black 8%, ${e})`),