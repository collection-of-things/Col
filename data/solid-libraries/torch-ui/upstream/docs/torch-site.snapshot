import { ButtonGroup } from '@torch-ui/solid/actions'
import { DropdownMenuItem } from '@torch-ui/solid/navigation'
import { AlertDialog } from '@torch-ui/solid/overlays'

const [equipOpen, setEquipOpen] = createSignal(false)

<ButtonGroup split>
  <ButtonGroup.Main onClick={() => setEquipOpen(true)}>Equip</ButtonGroup.Main>
  <ButtonGroup.Menu>
    {() => (
      <>
        <DropdownMenuItem onSelect={() => {}}>Equip to Slot</DropdownMenuItem>
        <DropdownMenuItem onSelect={() => {}}>Store in Vault</DropdownMenuItem>
      </>
    )}
  </ButtonGroup.Menu>
</ButtonGroup>
<AlertDialog
  open={equipOpen()}
  onOpenChange={setEquipOpen}
  title="Equip this item?"
  description="Your current weapon will be unequipped and moved to your inventory."
  confirmLabel="Equip"
  onConfirm={() => {}}
/>`,GH=`import { createSignal } from 'solid-js'
