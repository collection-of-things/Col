{
  "name": "coc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A community-maintained directory for discovering UI libraries.",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:quoin": "node scripts/build-quoin-documentation.mjs && node scripts/build-quoin-previews.mjs",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry-run": "vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "bun run build && node --test --test-concurrency=1 --test-global-setup=tests/site-server.mjs \"lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.2",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@solidjs/compiler": "2.0.0-rc.18",
    "@solidjs/signals": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "es-module-lexer": "3.0.2",
    "esbuild": "0.25.12",
    "jsdom": "30.1.3",
    "postcss": "8.5.6",
    "quoin-ui": "0.6.0",
    "sharp": "^0.35.5",
    "solid-js": "2.0.0-rc.18",
    "sucrase": "3.35.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "wrangler": "^4.157.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "overrides": {
    "vite": {
      "esbuild": "$esbuild"
    }
  }
}
